# Environment
APP_ENV=development
APP_NAME=classroom-Healthcare-Medicaid-customer-service-agenticAI

# LLM Provider
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Safety
PHI_REDACTION_ENABLED=true
CLINICAL_DISCLAIMER_ENABLED=true

# Logging & Audit
LOG_LEVEL=INFO
AUDIT_LOG_PATH=logs/audit.log

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Integrations
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
RAG_BASE_URL=memory
API_GATEWAY_URL=local
API_GATEWAY_KEY=

# Infrastructure (AWS)
CLOUD_PROVIDER=aws
COMPUTE=eks
AWS_REGION=us-east-1
OBSERVABILITY=cloudwatch

# Data Stores
POSTGRES_URL=postgresql://localhost:5432/healthcare
REDIS_URL=redis://localhost:6379/0
S3_BUCKET=xyz-healthcare-documents
VECTOR_STORE_URL=memory
OPENSEARCH_URL=
